# Fichiers objets compilés
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.out
*.app

# Exécutable final (nommé simulateur, mais on peut ignorer tous les exécutables)
/simulateur
/simulateur.exe

# Dossier de compilation (obj/)
/obj/
/build/

# Doxygen génère la documentation dans doc/html et doc/latex
/doc/html/
/doc/latex/

# Fichiers de backup créés par certains éditeurs
*~
*.swp
*.swo
*.bak
*.tmp

# Répertoire .vs/ (Visual Studio)
.vs/

# Répertoire .vscode/
.vscode/
# Pour garder les paramètres d'espace de travail, commentez la ligne ci-dessus

# Fichiers de configuration spécifiques à l'IDE 
*.cbp
*.depend
*.layout
*.workspace

# Fichiers de projet Qt 
*.pro
*.pro.user
*.pri

# Fichiers de session gdb
.gdb_history
*.gdb

# Fichiers de tags (ctags)
tags
TAGS

# Fichiers de logs et rapports de couverture
*.log
*.gcov
*.gcda
*.gcno

# Dossiers d'archive (ne pas versionner les archives)
*.tgz
*.tar.gz
*.zip
*.7z

# Fichiers de test générés (par exemple CSV produits par le programme)
*.csv
# Ici on ignore tous les CSV sauf s'ils sont dans un dossier tests/data/ par exemple.



# Dossiers de sortie CSV créés par le programme
/output/
/results/

# Fichiers de configuration Doxygen (on garde Doxyfile car il est important)
# Ne pas ignorer Doxyfile


# Fichiers spécifiques à Windows (Thumbs.db, desktop.ini)
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Répertoire .idea/ (JetBrains)
.idea/

# Répertoire .settings/ (Eclipse)
.settings/
.classpath
.project

# Fichiers de couverture (lcov)
coverage/
*.info